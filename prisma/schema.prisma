generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String
  phone    String
  address  String?
  idCard   String?
  promptpay String?
  dormitories Dormitory[]
}

model Dormitory {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id])
  rooms     Room[]
}

model Room {
  id           Int        @id @default(autoincrement())
  name         String
  price        Int
  dormitoryId  Int
  dormitory    Dormitory  @relation(fields: [dormitoryId], references: [id])
  waterRate    Float?
  electricRate Float?
  waterFlat    Int?
  electricFlat Int?
  commonFee    Int?
  otherFee     Int?
  bills        Bill[]
  tenantRooms  TenantRoom[]
  rentalContracts RentalContract[]
}

model Tenant {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String
  idCard     String?
  address    String
  password   String
  rooms      TenantRoom[]
  bills      Bill[]
  rentalContracts RentalContract[]
}

model TenantRoom {
  id       Int    @id @default(autoincrement())
  tenantId Int
  roomId   Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  room     Room   @relation(fields: [roomId], references: [id])
  
  @@unique([tenantId, roomId])
}

model RentalContract {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id])
}

model Bill {
  id        Int      @id @default(autoincrement())
  billDate  DateTime
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  water     Int
  electric  Int
  common    Int
  other     Int      @default(0)
  rent      Int
  discount  Int      @default(0)
  total     Int
  meterWaterStart   Int?
  meterWaterEnd     Int?
  meterElectricStart Int?
  meterElectricEnd   Int?
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id])
}
