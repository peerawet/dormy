generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String
  phone    String
  address  String?
  idCard   String?
  promptpay String?
  linkCode String? @unique @default(uuid()) // UUID สำหรับเชื่อม LINE
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  dormitories Dormitory[]
  lineAccounts LineAccount[]
}

model Dormitory {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  ownerId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id])
  rooms     Room[]
  expenses  Expense[]
  recurringExpenses RecurringExpense[]
}

model Room {
  id           Int        @id @default(autoincrement())
  name         String
  price        Int
  dormitoryId  Int
  waterRate    Float?
  electricRate Float?
  waterFlat    Int?
  electricFlat Int?
  commonFee    Int?
  otherFee     Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  dormitory    Dormitory  @relation(fields: [dormitoryId], references: [id])
  bills        Bill[]
  tenantRooms  TenantRoom[]
  rentalContracts RentalContract[]
  expenses     Expense[]
  recurringExpenses RecurringExpense[]
}

model Tenant {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String
  idCard     String?
  address    String
  password   String
  linkCode   String?  @unique @default(uuid()) // UUID สำหรับเชื่อม LINE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  rooms      TenantRoom[]
  bills      Bill[]
  rentalContracts RentalContract[]
  lineAccounts LineAccount[]
}

model TenantRoom {
  id       Int    @id @default(autoincrement())
  tenantId Int
  roomId   Int
  createdAt DateTime @default(now())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  room     Room   @relation(fields: [roomId], references: [id])
  
  @@unique([tenantId, roomId])
}

model RentalContract {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  deposit   Int?
  insurance Int?
  tenantId  Int
  roomId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
}

model Bill {
  id        Int      @id @default(autoincrement())
  billDate  DateTime
  tenantId  Int
  water     Int
  electric  Int
  common    Int
  other     Int      @default(0)
  rent      Int
  discount  Int      @default(0)
  total     Int
  meterWaterStart   Int?
  meterWaterEnd     Int?
  meterElectricStart Int?
  meterElectricEnd   Int?
  roomId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
}

model Expense {
  id           Int       @id @default(autoincrement())
  dormitoryId  Int
  roomId       Int?      // Optional - ค่าใช้จ่ายเฉพาะห้อง (ถ้าไม่ระบุ = ค่าใช้จ่ายทั้งหอพัก)
  type         String    // ประเภทค่าใช้จ่าย เช่น "water", "electric", "maintenance", "cleaning", "repair", "other"
  description  String    // รายละเอียดค่าใช้จ่าย
  amount       Float     // จำนวนเงิน
  expenseDate  DateTime  // วันที่เกิดค่าใช้จ่าย
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  dormitory    Dormitory @relation(fields: [dormitoryId], references: [id])
  room         Room?     @relation(fields: [roomId], references: [id])
  
}

model RecurringExpense {
  id           Int       @id @default(autoincrement())
  dormitoryId  Int
  roomId       Int?      // Optional - ค่าใช้จ่ายประจำเฉพาะห้อง (ถ้าไม่ระบุ = ค่าใช้จ่ายประจำทั้งหอพัก)
  type         String    // ประเภทค่าใช้จ่าย เช่น "water", "electric", "maintenance", "cleaning", "repair", "other"
  description  String    // รายละเอียดค่าใช้จ่าย
  amount       Float     // จำนวนเงินต่อครั้ง
  frequency    String    // ความถี่: "monthly", "weekly", "yearly"
  dayOfMonth   Int?      // วันที่ของเดือนที่ต้องจ่าย (1-31) สำหรับ monthly
  isActive     Boolean   @default(true) // เปิด/ปิดการใช้งาน
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  dormitory    Dormitory @relation(fields: [dormitoryId], references: [id])
  room         Room?     @relation(fields: [roomId], references: [id])
  
}

// LINE Account linking - เชื่อม LINE User ID กับ User/Tenant ในระบบ
// 1 User/Tenant สามารถมีหลาย LINE ID ได้ (เช่น ใช้หลายเครื่อง)
model LineAccount {
  id           Int       @id @default(autoincrement())
  lineUserId   String    @unique  // LINE User ID (U...)
  role         String    // "owner" หรือ "tenant"
  userId       Int?      // FK to User (สำหรับ owner)
  tenantId     Int?      // FK to Tenant (สำหรับ tenant)
  displayName  String?   // ชื่อที่แสดงใน LINE
  pictureUrl   String?   // รูปโปรไฟล์ LINE
  richMenuId   String?   // Rich Menu ID ที่กำลังใช้อยู่
  isVerified   Boolean   @default(false) // ยืนยันตัวตนแล้วหรือยัง
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  user         User?     @relation(fields: [userId], references: [id])
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
}
